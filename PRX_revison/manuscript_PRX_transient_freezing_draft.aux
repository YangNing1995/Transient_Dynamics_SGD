\citation{xieDiffusionTheoryDeep2021,zhuAnisotropicNoiseStochastic2019,yangStochasticGradientDescent2023}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Freezing time organizes basin commitment and the geometry observed at commitment. (A) Median continuation-based freezing coordinate $\eta t_f$ across batch size and learning rate; gray cells indicate conditions without final-converged stable trajectories, and text marks stable fractions below 80\%. (B) Individual final-converged stable runs show the distribution of $\eta t_f$ across the effective noise proxy $\eta /B$. (C) Freezing-time flatness $F_f=-\log _{10}S_{\rm  rel}(\theta _{t_f})$, measured at the checkpoint corresponding to $t_f$, compared with $\eta /B$ (left) and with $\langle \eta t_f\rangle $ (right). (D) Final test accuracy compared with the same two organizing variables. Point colors indicate learning rate; comparison panels omit the highest-learning-rate sweep and include continuation-stable trajectories that converge at the final checkpoint.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:freezing_control}{{2}{4}{Freezing time organizes basin commitment and the geometry observed at commitment. (A) Median continuation-based freezing coordinate $\eta t_f$ across batch size and learning rate; gray cells indicate conditions without final-converged stable trajectories, and text marks stable fractions below 80\%. (B) Individual final-converged stable runs show the distribution of $\eta t_f$ across the effective noise proxy $\eta /B$. (C) Freezing-time flatness $F_f=-\log _{10}S_{\rm rel}(\theta _{t_f})$, measured at the checkpoint corresponding to $t_f$, compared with $\eta /B$ (left) and with $\langle \eta t_f\rangle $ (right). (D) Final test accuracy compared with the same two organizing variables. Point colors indicate learning rate; comparison panels omit the highest-learning-rate sweep and include continuation-stable trajectories that converge at the final checkpoint}{figure.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {V}Static Bias Is Real but Insufficient}{4}{section*.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Minimal two-valley model. (A) The coordinate $y$ describes downhill training, while $x$ distinguishes a flat and a sharp valley. The valleys separate and the barrier grows as $y$ increases. (B) Geometry-coupled noise is stronger along high-curvature directions, mimicking the anisotropic structure of SGD noise. (C) Simulated trajectories hop between valleys early and freeze into one valley later. (D) The model predicts that stronger effective noise $\Delta _S$ increases both the freezing time and the final probability of selecting the flat valley.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:minimal_model}{{3}{5}{Minimal two-valley model. (A) The coordinate $y$ describes downhill training, while $x$ distinguishes a flat and a sharp valley. The valleys separate and the barrier grows as $y$ increases. (B) Geometry-coupled noise is stronger along high-curvature directions, mimicking the anisotropic structure of SGD noise. (C) Simulated trajectories hop between valleys early and freeze into one valley later. (D) The model predicts that stronger effective noise $\Delta _S$ increases both the freezing time and the final probability of selecting the flat valley}{figure.3}{}}
\newlabel{eq:steady_state_bias}{{6}{5}{}{equation.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Static bias and its limitation. (A) On a fixed landscape slice, anisotropic noise induces an effective loss that favors the flatter valley. (B) The corresponding quasi-steady flat-valley probability $P_{\mathrm  {flat}}^{\mathrm  {ss}}(y)$ is larger than the equilibrium expectation. (C) At fixed $y$, increasing $\Delta _S$ can reduce instantaneous selectivity by mixing the two valleys. (D) The apparent contradiction is resolved by recognizing that stronger noise delays freezing, so the final probability is inherited from a later landscape slice.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:static_bias}{{4}{5}{Static bias and its limitation. (A) On a fixed landscape slice, anisotropic noise induces an effective loss that favors the flatter valley. (B) The corresponding quasi-steady flat-valley probability $P_{\mathrm {flat}}^{\mathrm {ss}}(y)$ is larger than the equilibrium expectation. (C) At fixed $y$, increasing $\Delta _S$ can reduce instantaneous selectivity by mixing the two valleys. (D) The apparent contradiction is resolved by recognizing that stronger noise delays freezing, so the final probability is inherited from a later landscape slice}{figure.4}{}}
