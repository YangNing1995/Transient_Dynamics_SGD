#!/bin/bash
#SBATCH -J fig4nw
#SBATCH -p gpu_4l
#SBATCH -N 1
#SBATCH -o ../err_out/fig4_neuron_wise_flatness_%j.out
#SBATCH -e ../err_out/fig4_neuron_wise_flatness_%j.err
#SBATCH --no-requeue
#SBATCH -A tangc_g1
#SBATCH --qos=tangcg4c
#SBATCH --gres=gpu:1
#SBATCH --overcommit
#SBATCH --mincpus=7

# Recompute the Fig. 4 continuation-training flatness panel with the current
# neuron-wise relative sharpness definition.

source /appsnew/source/Tensorflow2.5.0rc1_Keras2.4.3_keras-nightly2.5.0_torch1.8.1_py3.9.4_cuda11.2.2.sh
set -euo pipefail

CODE_DIR=/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/Numerical_experiments
BASE_CHECKPOINT_ROOT=/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/save_checkpoint_v2
CONTINUE_CHECKPOINT_ROOT=/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/save_checkpoint_continue_training
DATA_ROOT=/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/data
OUTPUT_ROOT=/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/fig4_neuron_wise_continue_flatness

LOAD_BS=50
LOAD_LR=0.05
LOAD_REPEAT=2
LOAD_ITERATION_RANGE=0:1000:20
CONTINUE_TOTAL_ITERATIONS=2000

RHO=0.05
NUM_DIRECTIONS=20

if [ ! -d "${DATA_ROOT}/MNIST" ]; then
  echo "ERROR: MNIST data directory not found at ${DATA_ROOT}/MNIST" >&2
  exit 1
fi

mkdir -p "${OUTPUT_ROOT}"
cd "${CODE_DIR}"
JOB_START=$(date +%s)

run_timed () {
  LABEL="$1"
  shift
  START=$(date +%s)
  echo "==== ${LABEL} started at $(date) ===="
  "$@"
  STATUS=$?
  END=$(date +%s)
  echo "==== ${LABEL} finished at $(date); elapsed $((END - START)) seconds; status ${STATUS} ===="
  return ${STATUS}
}

COMMON_ARGS=(
  --data_dir "${DATA_ROOT}"
  --base_checkpoint_dir "${BASE_CHECKPOINT_ROOT}"
  --continue_checkpoint_dir "${CONTINUE_CHECKPOINT_ROOT}"
  --output_dir "${OUTPUT_ROOT}"
  --load_batch_size "${LOAD_BS}"
  --load_learning_rate "${LOAD_LR}"
  --load_realization "${LOAD_REPEAT}"
  --load_iteration_range "${LOAD_ITERATION_RANGE}"
  --continue_total_iterations "${CONTINUE_TOTAL_ITERATIONS}"
  --rho "${RHO}"
  --num_directions "${NUM_DIRECTIONS}"
  --loss_type ce
  --eval_batch_size -1
  --max_train_batches -1
)

echo "Fig4 neuron-wise continuation flatness"
echo "Code dir: ${CODE_DIR}"
echo "Base checkpoints: ${BASE_CHECKPOINT_ROOT}"
echo "Continuation checkpoints: ${CONTINUE_CHECKPOINT_ROOT}"
echo "Output root: ${OUTPUT_ROOT}"
echo "Condition: bs=${LOAD_BS}, lr=${LOAD_LR}, repeat=${LOAD_REPEAT}"
echo "rho=${RHO}, directions=${NUM_DIRECTIONS}"

run_timed "dry_run" python "${CODE_DIR}/neuron_wise_continue_training.py" \
  "${COMMON_ARGS[@]}" \
  --mode both \
  --dry_run

run_timed "compute_fig4_neuron_wise_flatness" python "${CODE_DIR}/neuron_wise_continue_training.py" \
  "${COMMON_ARGS[@]}" \
  --mode both \
  --overwrite

SUMMARY="${OUTPUT_ROOT}/bs${LOAD_BS}_lr${LOAD_LR}_repeat${LOAD_REPEAT}_ct/neuron_wise_continue_flatness_summary.csv"
python - "${SUMMARY}" <<'PY'
import csv
import math
import sys

summary = sys.argv[1]
with open(summary, newline="") as f:
    rows = list(csv.DictReader(f))

bad = [row for row in rows if row.get("status") != "ok"]
if bad:
    print("ERROR: non-ok rows in {}".format(summary), file=sys.stderr)
    for row in bad[:20]:
        print(row, file=sys.stderr)
    sys.exit(1)

flat = [float(row["flatness_neg_log10"]) for row in rows if row.get("flatness_neg_log10")]
finite = [x for x in flat if math.isfinite(x)]
print("OK rows={} finite_flatness={} mean_flatness={:.4f}".format(len(rows), len(finite), sum(finite) / len(finite)))
PY

echo "Fig4 neuron-wise continuation flatness complete at $(date); elapsed $(( $(date +%s) - JOB_START )) seconds"
