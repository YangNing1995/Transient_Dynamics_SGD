#!/bin/bash
#SBATCH -J ft_bs1000
#SBATCH -p gpu_4l
#SBATCH -N 1
#SBATCH -o ../err_out/ft_seq_bs1000_%j.out
#SBATCH -e ../err_out/ft_seq_bs1000_%j.err
#SBATCH --no-requeue
#SBATCH -A tangc_g1
#SBATCH --qos=tangcg4c
#SBATCH --gres=gpu:1
#SBATCH --overcommit
#SBATCH --mincpus=7

source /appsnew/source/Tensorflow1.13_Keras2.2_Pytorch1.1_py3.7.3_cuda9.sh
# source /appsnew/source/Tensorflow2.5.0rc1_Keras2.4.3_keras-nightly2.5.0_torch1.8.1_py3.9.4_cuda11.2.2.sh
set -euo pipefail

# B=1000 is full-batch GD for the 1000-sample training set used here.
# With continuation_lr matched to the trajectory lr, continuation follows the
# same deterministic GD map, so every checkpoint is already committed to the
# same endpoint as the reference trajectory. Treat this condition as tf=0 and
# do not spend GPU time recomputing continuation probes.
OUTPUT_ROOT=${OUTPUT_ROOT:-/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/freezing_time_training_lr_r1-5_ce}
BS=1000
LR_LIST=(0.1 0.05 0.02 0.01 0.005 0.002)

echo "Skipping freezing-time continuation for B=${BS}."
echo "Reason: matched-lr continuation degenerates to the original deterministic GD trajectory."
echo "Use analytic freezing time tf=0 and eta_tf=0 for LR_LIST: ${LR_LIST[*]}."
echo "Output root for non-GD matched-lr runs: ${OUTPUT_ROOT}"
