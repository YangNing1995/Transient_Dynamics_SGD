#!/bin/bash
#SBATCH -J frzflat3
#SBATCH -p gpu_4l
#SBATCH -N 1
#SBATCH -o ../err_out/freezing_flatness_three_methods_%j.out
#SBATCH -e ../err_out/freezing_flatness_three_methods_%j.err
#SBATCH --no-requeue
#SBATCH -A tangc_g1
#SBATCH --qos=tangcg4c
#SBATCH --gres=gpu:1
#SBATCH --overcommit
#SBATCH --mincpus=7

# Computes freezing-time flatness with all definitions used for comparison:
#   1. tensor_wise  : tensor-wise relative sharpness
#   2. neuron_wise  : neuron-wise relative sharpness
#   3. hessian_topk : top-k Hessian-eigenvalue sharpness
#
# Results are written under one root folder, with one subfolder per definition.

source /appsnew/source/Tensorflow2.5.0rc1_Keras2.4.3_keras-nightly2.5.0_torch1.8.1_py3.9.4_cuda11.2.2.sh
set -euo pipefail

CODE_DIR=/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/Numerical_experiments
CHECKPOINT_ROOT=/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/save_checkpoint_v2
FREEZING_ROOT=/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/freezing_time_all_ce/jaccard095
DATA_ROOT=/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/data
OUTPUT_ROOT=/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/freezing_flatness_three_methods_ce

SUBDIR_TEMPLATE='bs{batch_size}_lr{learning_rate:g}_repeat{repeat}'
LR_LIST=(0.001 0.002 0.005 0.01 0.02 0.05 0.1)
BS_LIST_MAIN=(10 20 50 100 200 500)
BS_LIST_REF=(1000)
EXPECTED_ROWS=847

RHO=0.05
NUM_DIRECTIONS=20
FREEZE_ROUNDING=ceil
HESSIAN_TOPK=10
HESSIAN_LAYER_INDEX=2

if [ ! -d "${DATA_ROOT}/MNIST" ]; then
  echo "ERROR: MNIST data directory not found at ${DATA_ROOT}/MNIST" >&2
  exit 1
fi

mkdir -p "${OUTPUT_ROOT}"
cd "${CODE_DIR}"
JOB_START=$(date +%s)

run_timed () {
  LABEL="$1"
  shift
  START=$(date +%s)
  echo "==== ${LABEL} started at $(date) ===="
  "$@"
  STATUS=$?
  END=$(date +%s)
  echo "==== ${LABEL} finished at $(date); elapsed $((END - START)) seconds; status ${STATUS} ===="
  return ${STATUS}
}

require_summary_ok () {
  SUMMARY="$1"
  EXPECT_ROWS="$2"
  if [ ! -f "${SUMMARY}" ]; then
    echo "ERROR: required summary is missing: ${SUMMARY}" >&2
    exit 1
  fi
  python - "$SUMMARY" "$EXPECT_ROWS" <<'PY'
import csv
import math
import sys
from collections import defaultdict

summary_path = sys.argv[1]
expect_rows = int(sys.argv[2])
with open(summary_path, newline="") as f:
    rows = list(csv.DictReader(f))

bad = [row for row in rows if row.get("status") != "ok"]
if bad:
    print("ERROR: non-ok rows in {}".format(summary_path), file=sys.stderr)
    for row in bad[:20]:
        print(
            "  bs={batch_size} lr={learning_rate} repeat={repeat} status={status} message={message}".format(**row),
            file=sys.stderr,
        )
    sys.exit(1)

if len(rows) != expect_rows:
    print("ERROR: expected {} rows, found {} rows in {}".format(expect_rows, len(rows), summary_path), file=sys.stderr)
    sys.exit(1)

definition = rows[0].get("definition", "")
total_wall = sum(float(row.get("wall_time_sec") or 0.0) for row in rows)
sharp = [float(row["sharpness_mean_positive_delta"]) for row in rows if row.get("sharpness_mean_positive_delta")]
flat = [float(row["flatness_neg_log10"]) for row in rows if row.get("flatness_neg_log10")]
nonfinite_flat = sum(not math.isfinite(x) for x in flat)

print(
    "OK summary: definition={} rows={} total_wall_sec={:.1f} mean_sharpness={:.6g} mean_flat={:.4f} nonfinite_flat={}".format(
        definition,
        len(rows),
        total_wall,
        sum(sharp) / len(sharp) if sharp else float("nan"),
        sum(x for x in flat if math.isfinite(x)) / max(1, sum(math.isfinite(x) for x in flat)),
        nonfinite_flat,
    )
)

by_lr = defaultdict(list)
for row in rows:
    by_lr[row["learning_rate"]].append(row)

print("By learning rate:")
for lr in sorted(by_lr, key=float):
    group = by_lr[lr]
    values = [float(row["flatness_neg_log10"]) for row in group if row.get("flatness_neg_log10")]
    values = [x for x in values if math.isfinite(x)]
    mean_flat = sum(values) / len(values) if values else float("nan")
    print("  lr={} rows={} mean_flat={:.4f}".format(lr, len(group), mean_flat))
PY
}

run_definition () {
  DEFINITION="$1"
  OUT_DIR="$2"
  EXTRA_ARGS=("${@:3}")

  mkdir -p "${OUT_DIR}"
  COMMON_ARGS=(
    --data_dir "${DATA_ROOT}"
    --checkpoint_dir "${CHECKPOINT_ROOT}"
    --checkpoint_subdir_template "${SUBDIR_TEMPLATE}"
    --freezing_summary_root "${FREEZING_ROOT}"
    --output_dir "${OUT_DIR}"
    --checkpoint_iteration freezing
    --freeze_rounding "${FREEZE_ROUNDING}"
    --definition "${DEFINITION}"
    --rho "${RHO}"
    --loss_type ce
    --max_train_batches -1
  )

  echo
  echo "################ ${DEFINITION} ################"
  echo "Output: ${OUT_DIR}"
  echo "Extra args: ${EXTRA_ARGS[*]:-none}"

  run_timed "dry_run_${DEFINITION}_main_bs10_to_500" python "${CODE_DIR}/compute_relative_sharpness.py" \
    "${COMMON_ARGS[@]}" "${EXTRA_ARGS[@]}" \
    --batch_sizes "${BS_LIST_MAIN[@]}" \
    --learning_rates "${LR_LIST[@]}" \
    --repeat_start 1 \
    --repeat_end 20 \
    --dry_run

  run_timed "dry_run_${DEFINITION}_bs1000" python "${CODE_DIR}/compute_relative_sharpness.py" \
    "${COMMON_ARGS[@]}" "${EXTRA_ARGS[@]}" \
    --batch_sizes "${BS_LIST_REF[@]}" \
    --learning_rates "${LR_LIST[@]}" \
    --repeat_start 1 \
    --repeat_end 1 \
    --dry_run

  run_timed "${DEFINITION}_main_bs10_to_500" python "${CODE_DIR}/compute_relative_sharpness.py" \
    "${COMMON_ARGS[@]}" "${EXTRA_ARGS[@]}" \
    --batch_sizes "${BS_LIST_MAIN[@]}" \
    --learning_rates "${LR_LIST[@]}" \
    --repeat_start 1 \
    --repeat_end 20

  run_timed "${DEFINITION}_bs1000" python "${CODE_DIR}/compute_relative_sharpness.py" \
    "${COMMON_ARGS[@]}" "${EXTRA_ARGS[@]}" \
    --batch_sizes "${BS_LIST_REF[@]}" \
    --learning_rates "${LR_LIST[@]}" \
    --repeat_start 1 \
    --repeat_end 1

  require_summary_ok "${OUT_DIR}/relative_sharpness_summary.csv" "${EXPECTED_ROWS}"
}

echo "Freezing flatness three-method comparison"
echo "Output root: ${OUTPUT_ROOT}"
echo "Data root: ${DATA_ROOT}"
echo "Checkpoint root: ${CHECKPOINT_ROOT}"
echo "Freezing root: ${FREEZING_ROOT}"
echo "rho=${RHO}, directions=${NUM_DIRECTIONS}, rounding=${FREEZE_ROUNDING}"

run_definition "tensor_wise" \
  "${OUTPUT_ROOT}/tensor_wise_rho0.05_k20_ceil" \
  --num_directions "${NUM_DIRECTIONS}"

run_definition "neuron_wise" \
  "${OUTPUT_ROOT}/neuron_wise_rho0.05_k20_ceil" \
  --num_directions "${NUM_DIRECTIONS}"

run_definition "hessian_topk" \
  "${OUTPUT_ROOT}/hessian_top10_layer2_ceil" \
  --hessian_topk "${HESSIAN_TOPK}" \
  --hessian_layer_index "${HESSIAN_LAYER_INDEX}"

echo "All three freezing-flatness definitions complete at $(date); elapsed $(( $(date +%s) - JOB_START )) seconds"
