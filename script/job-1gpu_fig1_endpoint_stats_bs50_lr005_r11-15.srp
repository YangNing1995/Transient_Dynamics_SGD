#!/bin/bash
#SBATCH -J fig1ep_r11_15
#SBATCH -p gpu_4l
#SBATCH -N 1
#SBATCH -o ../err_out/fig1_endpoint_stats_r11-15_%j.out
#SBATCH -e ../err_out/fig1_endpoint_stats_r11-15_%j.err
#SBATCH --no-requeue
#SBATCH -A tangc_g1
#SBATCH --qos=tangcg4c
#SBATCH --gres=gpu:1
#SBATCH --overcommit
#SBATCH --mincpus=7

source /appsnew/source/Tensorflow2.5.0rc1_Keras2.4.3_keras-nightly2.5.0_torch1.8.1_py3.9.4_cuda11.2.2.sh
set -euo pipefail
REPEAT_START=11
REPEAT_END=15
RANGE_TAG=r11-15
CODE_DIR=${CODE_DIR:-/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/Numerical_experiments}
CHECKPOINT_ROOT=${CHECKPOINT_ROOT:-/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/save_checkpoint_v2}
OUTPUT_ROOT=${OUTPUT_ROOT:-/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/fig1_endpoint_stats_bs50_lr0.05_ce_uniform_grid}
DATA_ROOT=${DATA_ROOT:-/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/data}
if [ ! -d "${DATA_ROOT}/MNIST" ]; then echo "ERROR: MNIST data directory not found at ${DATA_ROOT}/MNIST" >&2; exit 1; fi
BS=${BS:-50}; LR=${LR:-0.05}; REFERENCE_ITERATION=${REFERENCE_ITERATION:-2000}; TC_START=${TC_START:-0}; TC_STOP=${TC_STOP:-1000}; TC_STRIDE=${TC_STRIDE:-20}
SUBDIR_TEMPLATE=${SUBDIR_TEMPLATE:-'bs{batch_size}_lr{learning_rate:g}_repeat{repeat}'}; LOSS_TYPE=${LOSS_TYPE:-ce}; HESSIAN_TOPK=${HESSIAN_TOPK:-10}; HESSIAN_LAYER_INDEX=${HESSIAN_LAYER_INDEX:-2}
OUT_DIR=${OUTPUT_ROOT}/${RANGE_TAG}
EXPECTED_ROWS=$(( (REPEAT_END - REPEAT_START + 1) * ((TC_STOP - TC_START) / TC_STRIDE + 1) ))
mkdir -p "${OUTPUT_ROOT}" "${OUT_DIR}"; cd "${CODE_DIR}"; JOB_START=$(date +%s)
run_timed () { LABEL="$1"; shift; START=$(date +%s); echo "==== ${LABEL} started at $(date) ===="; "$@"; STATUS=$?; END=$(date +%s); echo "==== ${LABEL} finished at $(date); elapsed $((END - START)) seconds; status ${STATUS} ===="; return ${STATUS}; }
require_summary_ok () { python - "$1" "$2" <<'PY'
import csv, sys
with open(sys.argv[1], newline="") as f: rows=list(csv.DictReader(f))
bad=[r for r in rows if r.get("status")!="ok"]
if bad:
    print("ERROR: non-ok rows", file=sys.stderr); sys.exit(1)
if len(rows)!=int(sys.argv[2]):
    print(f"ERROR: expected {sys.argv[2]} rows, found {len(rows)}", file=sys.stderr); sys.exit(1)
print(f"OK summary: rows={len(rows)}")
PY
}
COMMON_ARGS=" --data_dir ${DATA_ROOT} --checkpoint_dir ${CHECKPOINT_ROOT} --checkpoint_subdir_template ${SUBDIR_TEMPLATE} --output_dir ${OUT_DIR} --dataset_name MNIST --train_num 100 --test_num 20 --hidden_num 50 --batch_size ${BS} --learning_rate ${LR} --repeat_start ${REPEAT_START} --repeat_end ${REPEAT_END} --reference_iteration ${REFERENCE_ITERATION} --checkpoint_start ${TC_START} --checkpoint_stop ${TC_STOP} --checkpoint_stride ${TC_STRIDE} --continuation_lr training --continuation_batch_size -1 --continuation_micro_batch_size -1 --loss_type ${LOSS_TYPE} --hessian_topk ${HESSIAN_TOPK} --hessian_layer_index ${HESSIAN_LAYER_INDEX} --max_train_batches -1"
echo "Fig1 endpoint stats ${RANGE_TAG}: B=${BS}, lr=${LR}, t_c=${TC_START}:${TC_STRIDE}:${TC_STOP}"
run_timed "dry_run_${RANGE_TAG}" python "${CODE_DIR}/compute_continuation_endpoint_stats.py" ${COMMON_ARGS} --dry_run
run_timed "endpoint_stats_${RANGE_TAG}" python "${CODE_DIR}/compute_continuation_endpoint_stats.py" ${COMMON_ARGS}
require_summary_ok "${OUT_DIR}/endpoint_stats_summary.csv" "${EXPECTED_ROWS}"
echo "Job ${RANGE_TAG} complete at $(date); elapsed $(( $(date +%s) - JOB_START )) seconds"
