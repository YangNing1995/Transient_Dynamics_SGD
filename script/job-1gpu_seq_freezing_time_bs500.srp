#!/bin/bash
#SBATCH -J ft_bs500
#SBATCH -p gpu_4l
#SBATCH -N 1
#SBATCH -o ../err_out/ft_seq_bs500_%j.out
#SBATCH -e ../err_out/ft_seq_bs500_%j.err
#SBATCH --no-requeue
#SBATCH -A tangc_g1
#SBATCH --qos=tangcg4c
#SBATCH --gres=gpu:1
#SBATCH --overcommit
#SBATCH --mincpus=7

source /appsnew/source/Tensorflow1.13_Keras2.2_Pytorch1.1_py3.7.3_cuda9.sh
# source /appsnew/source/Tensorflow2.5.0rc1_Keras2.4.3_keras-nightly2.5.0_torch1.8.1_py3.9.4_cuda11.2.2.sh
set -euo pipefail

CODE_DIR=/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/Numerical_experiments
DATA_ROOT=${CODE_DIR}/data
CHECKPOINT_ROOT=/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/save_checkpoint_v2
OUTPUT_ROOT=${OUTPUT_ROOT:-/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/freezing_time_training_lr_r1-5_ce}
PILOT_CACHE_ROOT=${PILOT_CACHE_ROOT:-/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/freezing_time_training_lr_pilot_r1_ce}

BS=500
LR_LIST=(0.1 0.05 0.02 0.01 0.005 0.002)
SUBDIR_TEMPLATE='bs{batch_size}_lr{learning_rate:g}_repeat{repeat}'
LOSS_TYPE=ce
RUN_PRED099=1

REPEAT_START=1
REPEAT_END=5

mkdir -p "${OUTPUT_ROOT}"
cd "${CODE_DIR}"
JOB_START=$(date +%s)

run_timed () {
  LABEL="$1"
  shift
  START=$(date +%s)
  echo "==== ${LABEL} started at $(date) ===="
  "$@"
  STATUS=$?
  END=$(date +%s)
  echo "==== ${LABEL} finished at $(date); elapsed $((END - START)) seconds; status ${STATUS} ===="
  return ${STATUS}
}

require_summary_ok () {
  SUMMARY="$1"
  if [ ! -f "${SUMMARY}" ]; then
    echo "ERROR: required summary is missing: ${SUMMARY}" >&2
    exit 1
  fi
  python - "$SUMMARY" <<'PY'
import csv
import sys

summary_path = sys.argv[1]
with open(summary_path, newline="") as f:
    rows = list(csv.DictReader(f))

if not rows:
    print("ERROR: summary has no rows: {}".format(summary_path), file=sys.stderr)
    sys.exit(1)

bad = [row for row in rows if row.get("status") != "ok"]
if bad:
    print("ERROR: non-ok rows in {}".format(summary_path), file=sys.stderr)
    for row in bad:
        print(
            "  bs={batch_size} lr={learning_rate} repeat={repeat} status={status} message={message}".format(**row),
            file=sys.stderr,
        )
    sys.exit(1)

total_wall = sum(float(row.get("trajectory_wall_time_sec") or 0.0) for row in rows)
total_steps = sum(float(row.get("computed_continuation_steps") or 0.0) for row in rows)
print("OK summary: rows={} total_steps={} total_wall_sec={:.1f}".format(len(rows), int(total_steps), total_wall))
PY
}

echo "Sequential BS job: B=${BS}, repeats=${REPEAT_START}..${REPEAT_END}"
echo "Output root: ${OUTPUT_ROOT}"

for LR in "${LR_LIST[@]}"; do
  CONDITION_TAG=bs${BS}_lr${LR}
  JACCARD_OUT=${OUTPUT_ROOT}/jaccard09/${CONDITION_TAG}
  JACCARD095_OUT=${OUTPUT_ROOT}/jaccard095/${CONDITION_TAG}
  PRED_OUT=${OUTPUT_ROOT}/pred099/${CONDITION_TAG}

  EVAL_EVERY=$(python -c "import math; lr=float('${LR}'); print(max(10, int(math.ceil(1.0 / lr))))")
  MIN_CONTINUATION_STEPS=$(python -c "import math; lr=float('${LR}'); print(max(100, int(math.ceil(5.0 / lr))))")
  COARSE_CHECKPOINT_STRIDE=$(python -c "lr=float('${LR}'); print(20 if lr <= 0.005 else 10)")
  FINE_CHECKPOINT_STRIDE=$(python -c "lr=float('${LR}'); print(5 if lr <= 0.005 else 1)")
  echo "Condition ${CONDITION_TAG}: repeats=${REPEAT_START}..${REPEAT_END}, eval_every=${EVAL_EVERY}, min_continuation_steps=${MIN_CONTINUATION_STEPS}, coarse_stride=${COARSE_CHECKPOINT_STRIDE}, fine_stride=${FINE_CHECKPOINT_STRIDE}"

  COMMON_ARGS="\
    --data_dir ${DATA_ROOT} \
    --checkpoint_dir ${CHECKPOINT_ROOT} \
    --checkpoint_subdir_template ${SUBDIR_TEMPLATE} \
    --batch_sizes ${BS} \
    --learning_rates ${LR} \
    --repeat_start ${REPEAT_START} \
    --repeat_end ${REPEAT_END} \
    --reference_iteration auto \
    --continuation_budget_mode to_reference \
    --continuation_lr training \
    --loss_type ${LOSS_TYPE} \
    --coarse_checkpoint_stride ${COARSE_CHECKPOINT_STRIDE} \
    --fine_checkpoint_stride ${FINE_CHECKPOINT_STRIDE} \
    --early_stop_loss 0.005 \
    --early_stop_acc 1.0 \
    --early_stop_patience 3 \
    --min_continuation_steps ${MIN_CONTINUATION_STEPS} \
    --eval_every ${EVAL_EVERY} \
    --max_continuation_steps 2000"

  mkdir -p "${JACCARD_OUT}" "${PRED_OUT}"
  if [ ! -d "${JACCARD_OUT}/endpoints" ]; then
    if [ -d "${PILOT_CACHE_ROOT}/jaccard09/${CONDITION_TAG}/endpoints" ]; then
      cp -r "${PILOT_CACHE_ROOT}/jaccard09/${CONDITION_TAG}/endpoints" "${JACCARD_OUT}/endpoints"
    elif [ -d "${JACCARD095_OUT}/endpoints" ]; then
      cp -r "${JACCARD095_OUT}/endpoints" "${JACCARD_OUT}/endpoints"
    fi
  fi

  run_timed "jaccard09_${CONDITION_TAG}" python "${CODE_DIR}/compute_freezing_time.py" \
    ${COMMON_ARGS} \
    --output_dir "${JACCARD_OUT}" \
    --basin_mode jaccard \
    --jaccard_threshold 0.9
  require_summary_ok "${JACCARD_OUT}/freezing_time_summary.csv"

  if [ "${RUN_PRED099}" = "1" ]; then
    mkdir -p "${PRED_OUT}/endpoints"
    cp -n "${JACCARD_OUT}/endpoints/"*.npz "${PRED_OUT}/endpoints/" 2>/dev/null || true
    if [ -d "${PILOT_CACHE_ROOT}/pred099/${CONDITION_TAG}/endpoints" ]; then
      cp "${PILOT_CACHE_ROOT}/pred099/${CONDITION_TAG}/endpoints/"*.npz "${PRED_OUT}/endpoints/" 2>/dev/null || true
    fi
    run_timed "pred099_${CONDITION_TAG}" python "${CODE_DIR}/compute_freezing_time.py" \
      ${COMMON_ARGS} \
      --output_dir "${PRED_OUT}" \
      --basin_mode pred \
      --pred_threshold 0.99
    require_summary_ok "${PRED_OUT}/freezing_time_summary.csv"
  else
    echo "Skipping pred099 for ${CONDITION_TAG}. Set RUN_PRED099=1 to enable this robustness check."
  fi

done

echo "Sequential BS job complete: B=${BS} at $(date); elapsed $(( $(date +%s) - JOB_START )) seconds"
