#!/bin/bash
#SBATCH -J relsharp4
#SBATCH -p gpu_4l
#SBATCH -N 1
#SBATCH -o ../err_out/relsharp_fig4_%j.out
#SBATCH -e ../err_out/relsharp_fig4_%j.err
#SBATCH --no-requeue
#SBATCH -A tangc_g1
#SBATCH --qos=tangcg4c
#SBATCH --gres=gpu:1
#SBATCH --overcommit
#SBATCH --mincpus=7

source /appsnew/source/Tensorflow1.13_Keras2.2_Pytorch1.1_py3.7.3_cuda9.sh
# source /appsnew/source/Tensorflow2.5.0rc1_Keras2.4.3_keras-nightly2.5.0_torch1.8.1_py3.9.4_cuda11.2.2.sh
set -euo pipefail

CODE_DIR=/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/Numerical_experiments
DATA_ROOT=${CODE_DIR}/data
CHECKPOINT_ROOT=/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/save_checkpoint_v2
OUTPUT_ROOT=/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/relative_sharpness_validation_fig4

# Match the previous Fig. 4 validation trajectory first.
BATCH_SIZE=50
LR=0.05
REPEAT_START=2
REPEAT_END=2
SUBDIR_TEMPLATE='bs{batch_size}_lr{learning_rate:g}_repeat{repeat}'

RHO=0.05
NUM_DIRECTIONS=20

mkdir -p "${OUTPUT_ROOT}"
cd "${CODE_DIR}"
JOB_START=$(date +%s)

run_timed () {
  LABEL="$1"
  shift
  START=$(date +%s)
  echo "==== ${LABEL} started at $(date) ===="
  "$@"
  STATUS=$?
  END=$(date +%s)
  echo "==== ${LABEL} finished at $(date); elapsed $((END - START)) seconds; status ${STATUS} ===="
  return ${STATUS}
}

require_summary_ok () {
  SUMMARY="$1"
  if [ ! -f "${SUMMARY}" ]; then
    echo "ERROR: required summary is missing: ${SUMMARY}" >&2
    exit 1
  fi
  python - "$SUMMARY" <<'PY'
import csv
import sys

summary_path = sys.argv[1]
with open(summary_path, newline="") as f:
    rows = list(csv.DictReader(f))

bad = [row for row in rows if row.get("status") != "ok"]
if not rows or bad:
    print("ERROR: bad relative-sharpness summary: {}".format(summary_path), file=sys.stderr)
    for row in bad:
        print(
            "  bs={batch_size} lr={learning_rate} repeat={repeat} status={status} message={message}".format(**row),
            file=sys.stderr,
        )
    sys.exit(1)

for row in rows:
    print(
        "OK summary: bs={batch_size} lr={learning_rate} repeat={repeat} "
        "iter={checkpoint_iteration} sharp={sharpness_mean_positive_delta} "
        "flat_inv={relative_flatness_inverse} test_acc={base_test_accuracy} "
        "wall={wall_time_sec}s".format(**row)
    )
PY
}

echo "Dry run: check checkpoint discovery"
run_timed "dry_run" python "${CODE_DIR}/compute_relative_sharpness.py" \
  --data_dir "${DATA_ROOT}" \
  --checkpoint_dir "${CHECKPOINT_ROOT}" \
  --checkpoint_subdir_template "${SUBDIR_TEMPLATE}" \
  --output_dir "${OUTPUT_ROOT}/dry_run" \
  --batch_sizes "${BATCH_SIZE}" \
  --learning_rates "${LR}" \
  --repeat_start "${REPEAT_START}" \
  --repeat_end "${REPEAT_END}" \
  --checkpoint_iteration auto \
  --dry_run

echo "Run one-sided relative sharpness"
run_timed "relative_sharpness" python "${CODE_DIR}/compute_relative_sharpness.py" \
  --data_dir "${DATA_ROOT}" \
  --checkpoint_dir "${CHECKPOINT_ROOT}" \
  --checkpoint_subdir_template "${SUBDIR_TEMPLATE}" \
  --output_dir "${OUTPUT_ROOT}/rho${RHO}_k${NUM_DIRECTIONS}" \
  --batch_sizes "${BATCH_SIZE}" \
  --learning_rates "${LR}" \
  --repeat_start "${REPEAT_START}" \
  --repeat_end "${REPEAT_END}" \
  --checkpoint_iteration auto \
  --loss_type ce \
  --rho "${RHO}" \
  --num_directions "${NUM_DIRECTIONS}" \
  --max_train_batches -1 \
  --overwrite

SUMMARY="${OUTPUT_ROOT}/rho${RHO}_k${NUM_DIRECTIONS}/relative_sharpness_summary.csv"
require_summary_ok "${SUMMARY}"
cat "${SUMMARY}"

echo "Total validation job elapsed $(( $(date +%s) - JOB_START )) seconds"
