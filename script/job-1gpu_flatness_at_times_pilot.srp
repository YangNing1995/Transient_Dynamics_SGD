#!/bin/bash
#SBATCH -J flat_time
#SBATCH -p gpu_4l
#SBATCH -N 1
#SBATCH -o ../err_out/flatness_at_times_%j.out
#SBATCH -e ../err_out/flatness_at_times_%j.err
#SBATCH --no-requeue
#SBATCH -A tangc_g1
#SBATCH --qos=tangcg4c
#SBATCH --gres=gpu:1
#SBATCH --overcommit
#SBATCH --mincpus=7

source /appsnew/source/Tensorflow1.13_Keras2.2_Pytorch1.1_py3.7.3_cuda9.sh
# source /appsnew/source/Tensorflow2.5.0rc1_Keras2.4.3_keras-nightly2.5.0_torch1.8.1_py3.9.4_cuda11.2.2.sh
set -euo pipefail

CODE_DIR=/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/Numerical_experiments
DATA_ROOT=${CODE_DIR}/data
CHECKPOINT_ROOT=/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/save_checkpoint_v2
FREEZING_ROOT=/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/freezing_time_all_ce/jaccard095
OUTPUT_ROOT=/appsnew/home/tangc_pkuhpc/lustre1/YN/pytorch/flatness_at_times_pilot/random_filter_rho0.05_k20_repeats1-5

SUBDIR_TEMPLATE='bs{batch_size}_lr{learning_rate:g}_repeat{repeat}'
CONDITIONS=(
  50:0.05
  20:0.02
  100:0.002
  200:0.01
)

RHO=0.05
NUM_DIRECTIONS=20
REPEAT_START=1
REPEAT_END=5
ACC_THRESHOLD=0.999

mkdir -p "${OUTPUT_ROOT}"
cd "${CODE_DIR}"
JOB_START=$(date +%s)

run_timed () {
  LABEL="$1"
  shift
  START=$(date +%s)
  echo "==== ${LABEL} started at $(date) ===="
  "$@"
  STATUS=$?
  END=$(date +%s)
  echo "==== ${LABEL} finished at $(date); elapsed $((END - START)) seconds; status ${STATUS} ===="
  return ${STATUS}
}

require_summary_ok () {
  SUMMARY="$1"
  EXPECT_ROWS="$2"
  if [ ! -f "${SUMMARY}" ]; then
    echo "ERROR: required summary is missing: ${SUMMARY}" >&2
    exit 1
  fi
  python - "$SUMMARY" "$EXPECT_ROWS" <<'PY'
import csv
import sys
from collections import defaultdict

summary_path = sys.argv[1]
expect_rows = int(sys.argv[2])
with open(summary_path, newline="") as f:
    rows = list(csv.DictReader(f))

bad = [row for row in rows if row.get("status") != "ok"]
if bad:
    print("ERROR: non-ok rows in {}".format(summary_path), file=sys.stderr)
    for row in bad[:20]:
        print(
            "  bs={batch_size} lr={learning_rate} repeat={repeat} label={time_label} "
            "status={status} message={message}".format(**row),
            file=sys.stderr,
        )
    sys.exit(1)

if len(rows) != expect_rows:
    print(
        "ERROR: expected {} rows, found {} rows in {}".format(expect_rows, len(rows), summary_path),
        file=sys.stderr,
    )
    sys.exit(1)

by_label = defaultdict(list)
for row in rows:
    by_label[row["time_label"]].append(row)

for label in ["freeze", "acc", "final"]:
    group = by_label[label]
    mean_flat = sum(float(row["flatness_neg_log10"]) for row in group) / len(group)
    mean_test_loss = sum(float(row["test_loss"]) for row in group) / len(group)
    mean_test_acc = sum(float(row["test_accuracy"]) for row in group) / len(group)
    print(
        "OK {}: rows={} mean_flat={:.4f} mean_test_loss={:.4f} mean_test_acc={:.4f}".format(
            label, len(group), mean_flat, mean_test_loss, mean_test_acc
        )
    )
PY
}

COMMON_ARGS="\
  --data_dir ${DATA_ROOT} \
  --checkpoint_dir ${CHECKPOINT_ROOT} \
  --checkpoint_subdir_template ${SUBDIR_TEMPLATE} \
  --freezing_summary_root ${FREEZING_ROOT} \
  --output_dir ${OUTPUT_ROOT} \
  --conditions ${CONDITIONS[*]} \
  --repeat_start ${REPEAT_START} \
  --repeat_end ${REPEAT_END} \
  --acc_threshold ${ACC_THRESHOLD} \
  --freeze_rounding ceil \
  --definition random_filter \
  --rho ${RHO} \
  --num_directions ${NUM_DIRECTIONS} \
  --loss_type ce \
  --max_train_batches -1"

echo "Flatness-at-times pilot"
echo "Output root: ${OUTPUT_ROOT}"
echo "Conditions: ${CONDITIONS[*]}"
echo "Repeats: ${REPEAT_START}..${REPEAT_END}"

run_timed "dry_run" python "${CODE_DIR}/compute_flatness_at_times.py" \
  ${COMMON_ARGS} \
  --dry_run

run_timed "flatness_at_times" python "${CODE_DIR}/compute_flatness_at_times.py" \
  ${COMMON_ARGS}

SUMMARY="${OUTPUT_ROOT}/flatness_at_times_summary.csv"
require_summary_ok "${SUMMARY}" 60

echo "Final summary:"
cat "${SUMMARY}"

echo "Flatness-at-times pilot complete at $(date); elapsed $(( $(date +%s) - JOB_START )) seconds"
