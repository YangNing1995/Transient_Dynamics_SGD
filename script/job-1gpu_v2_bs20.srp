#!/bin/bash
#SBATCH -J yn231115
#SBATCH -p gpu_4l
#SBATCH -N 1 
#SBATCH -o ../err_out/yn231115_%j.out
#SBATCH -e ../err_out/yn231115_%j.err
#SBATCH --no-requeue
#SBATCH -A tangc_g1
#SBATCH --qos=tangcg4c
#SBATCH --gres=gpu:1
#SBATCH --overcommit
#SBATCH --mincpus=7
source /appsnew/source/Tensorflow1.13_Keras2.2_Pytorch1.1_py3.7.3_cuda9.sh
# source /appsnew/source/Tensorflow2.5.0rc1_Keras2.4.3_keras-nightly2.5.0_torch1.8.1_py3.9.4_cuda11.2.2.sh
python ../code_v2/run_repeat.py --batch_size 20 --learning_rate 0.1 --total_iterations 1000
python ../code_v2/run_repeat.py --batch_size 20 --learning_rate 0.05 --total_iterations 2000 
python ../code_v2/run_repeat.py --batch_size 20 --learning_rate 0.02 --total_iterations 5000
python ../code_v2/run_repeat.py --batch_size 20 --learning_rate 0.01 --total_iterations 10000 
python ../code_v2/run_repeat.py --batch_size 20 --learning_rate 0.005 --total_iterations 20000
python ../code_v2/run_repeat.py --batch_size 20 --learning_rate 0.002 --total_iterations 50000 
python ../code_v2/run_repeat.py --batch_size 20 --learning_rate 0.001 --total_iterations 100000

