@article{rajuTheoreticalPerspectiveWaddingtons2023,
  title = {A Theoretical Perspective on {{Waddington}}'s Genetic Assimilation Experiments},
  author = {Raju, Archishman and Xue, BingKan and Leibler, Stanislas},
  year = 2023,
  month = dec,
  journal = {Proceedings of the National Academy of Sciences},
  volume = {120},
