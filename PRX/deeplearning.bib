  issn = {1552-4469},
  doi = {10.1038/s41589-023-01302-9},
  urldate = {2024-12-20},
  abstract = {The global regulation of cell growth rate on gene expression perturbs the performance of gene networks, which would impose complex variations on the cell-fate decision landscape. Here we use a simple synthetic circuit of mutual repression that allows a bistable landscape to examine how such global regulation would affect the stability of phenotypic landscape and the accompanying dynamics of cell-fate determination. We show that the landscape experiences a growth-rate-induced bifurcation between monostability and bistability. Theoretical and experimental analyses reveal that this bifurcating deformation of landscape arises from the unbalanced response of gene expression to growth variations. The path of growth transition across the bifurcation would reshape cell-fate decisions. These results demonstrate the importance of growth regulation on cell-fate determination processes, regardless of specific molecular signaling or regulation.},
  copyright = {2023 The Author(s), under exclusive licence to Springer Nature America, Inc.},
  langid = {english},
  keywords = {Bacteria,Networks and systems biology,Synthetic biology},
  file = {E:\Zotero\storage\ZXIM4DXD\Zhu 等 - 2023 - Unbalanced response to growth variations reshapes the cell fate decision landscape.pdf}
}

@misc{ziyinSGDConstantLarge2023,
  title = {{{SGD}} with a {{Constant Large Learning Rate Can Converge}} to {{Local Maxima}}},
  author = {Ziyin, Liu and Li, Botao and Simon, James B. and Ueda, Masahito},
  year = 2023,
  month = may,
  number = {arXiv:2107.11774},
  eprint = {2107.11774},
  primaryclass = {cs, math, stat},
  publisher = {arXiv},
  urldate = {2023-08-15},
  abstract = {Previous works on stochastic gradient descent (SGD) often focus on its success. In this work, we construct worst-case optimization problems illustrating that, when not in the regimes that the previous works often assume, SGD can exhibit many strange and potentially undesirable behaviors. Specifically, we construct landscapes and data distributions such that (1) SGD converges to local maxima, (2) SGD escapes saddle points arbitrarily slowly, (3) SGD prefers sharp minima over flat ones, and (4) AMSGrad converges to local maxima. We also realize results in a minimal neural network-like example. Our results highlight the importance of simultaneously analyzing the minibatch sampling, discrete-time updates rules, and realistic landscapes to understand the role of SGD in deep learning.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Machine Learning,Mathematics - Optimization and Control,Statistics - Machine Learning},
  file = {E\:\\Zotero\\storage\\UNN8T54W\\Ziyin et al_2023_SGD with a Constant Large Learning Rate Can Converge to Local Maxima.pdf;E\:\\Zotero\\storage\\9WHPQLJT\\2107.html}
}

@misc{ziyinStrengthMinibatchNoise2022,
  title = {Strength of {{Minibatch Noise}} in {{SGD}}},
  author = {Ziyin, Liu and Liu, Kangqiao and Mori, Takashi and Ueda, Masahito},
  year = 2022,
