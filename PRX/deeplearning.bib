@article{moralesRepresentationalDriftLearninginduced2025,
  title = {Representational Drift and Learning-Induced Stabilization in the Piriform Cortex},
  author = {Morales, Guillermo B. and Mu{\~n}oz, Miguel A. and Tu, Yuhai},
