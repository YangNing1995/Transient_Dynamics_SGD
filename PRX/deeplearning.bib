  author = {Murgas, Kevin A. and Saucan, Emil and Sandhu, Romeil},
  editor = {Benito, Rosa Maria and Cherifi, Chantal and Cherifi, Hocine and Moro, Esteban and Rocha, Luis M. and {Sales-Pardo}, Marta},
